# ═══════════════════════════════════════════════════════════════════════════
# Copy to .env.local. Never commit .env.local: it is gitignored, and every
# value below that is not blank is a live credential.
#
# Grouped by what breaks without it, so a half-configured checkout tells you
# what it can and cannot do instead of failing mysteriously:
#
#   1. REQUIRED           the app does not run
#   2. OWNER SIGN-IN      /app and the auth screens
#   3. AI                 parse, chat, voice, storefront copy
#   4. TRANSACTIONS       orders and invoices only
#   5. CHANNELS           Telegram and Messenger
#   6. MONEY              taking payments
#   7. OPTIONAL           email, brand font, test harness
#
# The public marketing site needs NOTHING below. That is deliberate and worth
# keeping: a clean clone must build and serve the waitlist with an empty file.
# ═══════════════════════════════════════════════════════════════════════════


# ── 1. REQUIRED ────────────────────────────────────────────────────────────
# Supabase, used as managed Postgres. The service role bypasses RLS, which is
# the point: RLS is ON for every table with ZERO policies, so this key is the
# only way in and it must never reach a browser. `src/lib/db.ts` imports
# 'server-only' so a mistake there is a build error, not a leak.
#   Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Where this deployment answers. Telegram is told to call back here, so it must
# be public HTTPS before a bot can be connected: a laptop needs a tunnel.
NEXT_PUBLIC_APP_URL=http://localhost:3000


# ── 2. OWNER SIGN-IN ───────────────────────────────────────────────────────
# Read by the Clerk SDK itself, never by our code, which is why they do not
# appear in any grep of src/. Owners sign in; customers never do.
#   npx clerk@latest init      (creates an app and writes these)
#   npx clerk@latest env pull  (fetches them for an existing app)
# Development keys are pk_test_/sk_test_ and work on localhost with no domain.
# Production keys are pk_live_/sk_live_ and need a verified domain first.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/app


# ── 3. AI ──────────────────────────────────────────────────────────────────
# Nothing outside src/lib/ai/models.ts may name a provider or a model. The
# router tries the gateway first, then direct Google, then Anthropic, and any
# ONE of these is enough to work.
#
# On Vercel deployments the gateway is keyless: VERCEL_OIDC_TOKEN is injected
# automatically, and `vercel env pull` writes a 12 hour one for local use, so
# you do not set it by hand.
AI_GATEWAY_API_KEY=
# Either name works for Google. GEMINI_API_KEY is the one aistudio.google.com
# gives you; GOOGLE_GENERATIVE_AI_API_KEY is what the AI SDK looks for.
GEMINI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# Fallback only. Anthropic takes no audio, so it is deliberately absent from
# the transcription chain rather than failing every voice note.
ANTHROPIC_API_KEY=


# ── 4. TRANSACTIONS ────────────────────────────────────────────────────────
# A DIRECT Postgres connection, needed ONLY by orders and invoices. PostgREST
# has no transactions, and stock decrement plus gapless invoice numbering both
# need one. Everything else still reads through the Supabase client above.
#
# Use the Supavisor TRANSACTION mode string, port 6543, not 5432. The client
# sets prepare:false, without which the SECOND request to any route dies with
# "prepared statement already exists".
#   Dashboard > Project Settings > Database > Connection string > Transaction
DATABASE_URL=


# ── 5. CHANNELS ────────────────────────────────────────────────────────────
# AES-256-GCM key for the BotFather and page tokens in
# channel_connections.token_ciphertext. 32 bytes, base64 or hex:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating it makes every stored channel token unreadable and every shop has to
# reconnect, so keep it with the database password, not in this file.
MONI_TOKEN_KEY=

# Messenger. The app secret signs every inbound delivery and belongs to US, not
# to a shop, so it is resolved by name through channel_connections.secret_ref
# and never stored per row. The verify token is whatever you type into Meta's
# webhook setup screen; it must match on both sides.
META_APP_SECRET=
META_VERIFY_TOKEN=

# Telegram needs no key here: each shop pastes its own BotFather token in
# /app/channels and it is stored encrypted under MONI_TOKEN_KEY.


# ── 6. MONEY ───────────────────────────────────────────────────────────────
# Routing is by CURRENCY, not preference. CutLuy settles USD only, so it cannot
# serve a riel shop, and riel is the default for local shops.

# KHR. The QR is generated OFFLINE from this account, so no network call and no
# Cambodia-IP problem. Only the verification needs the relay, because NBC blocks
# check-transaction from servers outside Cambodia and Vercel is not in Cambodia.
BAKONG_ACCOUNT=
BAKONG_MERCHANT_NAME=
BAKONG_MERCHANT_CITY=
BAKONG_RELAY_API_URL=
BAKONG_RELAY_TOKEN=

# USD. CUTLUY_TOKEN is the ck_live_ API key.
CUTLUY_TOKEN=
CUTLUY_API_URL=https://cutluy.com
CUTLUY_PAYMENT_LINK_ID=
# The ENDPOINT SECRET from CutLuy's webhook settings, which is a different value
# from the API key above. It signs every delivery, and without it
# /api/webhooks/cutluy refuses everything rather than trusting what it cannot
# verify. Webhooks beat polling: creates are 60/min per key, reads 600/min.
CUTLUY_WEBHOOK_SECRET=


# ── 7. OPTIONAL ────────────────────────────────────────────────────────────
# Waitlist confirmation and invoice email.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Moni <hello@moni.cam>

# Adobe Fonts kit id, and ONLY the id: the bit between use.typekit.net/ and
# .css. Futura 100 Khmer already holds the first slot in --font-sans, so
# setting this starts it rendering. Never self host it: the TypeTogether EULA
# forbids converting it to a web format.
NEXT_PUBLIC_TYPEKIT_ID=

# `npm run test:mvp` only. Owner routes are authenticated, so the harness needs
# a real session: the `__session=...` cookie pair from a signed-in browser whose
# email is on the waitlist. That member must OWN the demo business, so set
# businesses.clerk_user_id on sokha-beauty to their Clerk user id first.
MONI_ACCEPTANCE_OWNER_COOKIE=
# Point the harness or the screenshot script at an already running server
# instead of letting them start one.
MONI_ACCEPTANCE_BASE_URL=
MONI_CAPTURE_URL=
