# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files. Everything real stays out; the EXAMPLE is the one file a fresh
# clone needs most, so it is explicitly un-ignored. Without this negation
# `.env*` swallows it and a new machine has nothing to copy from.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# capture output from `npm run shoot`
screenshots/

# references SUPABASE_ACCESS_TOKEN by env var; never commit
.mcp.json

# supabase CLI scratch: holds project ref and pooler connection details
supabase/.temp/
.clerk/

# subagent-driven-development scratch (ledger, briefs, review packages)
.superpowers/
